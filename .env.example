# ─────────────────────────────────────────────────────────────────────────────
# Findly configuration template. Copy to `.env` (git-ignored) — NEVER commit real values.
#
# Two kinds of settings live here:
#   1. ANDROID CLIENT (public, compiled into the APK) — read by app/build.gradle.kts
#      from environment variables or local.properties.
#   2. BACKEND (secret) — only for the future Findly backend service. These must
#      never be put into the Android app, local.properties or BuildConfig.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Android client (public values only) ──────────────────────────────────
# Base URL of the Findly backend. Empty = backend not connected, demo stores only.
FINDLY_API_BASE_URL=
# Keep the clearly-labelled demo stores enabled (true/false).
FINDLY_DEMO_PROVIDERS=true

# ── 2. Backend secrets (server only!) ───────────────────────────────────────
# Amazon Product Advertising API 5.0 (requires an approved Amazon Associates account)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.de

# eBay Browse API + eBay Partner Network
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=

# Affiliate networks with product feeds (Awin / CJ / Rakuten / Tradedoubler)
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
CJ_API_TOKEN=
CJ_WEBSITE_ID=

# AliExpress Affiliate (Portals) API
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# AI: query understanding / re-ranking / visual search
ANTHROPIC_API_KEY=
GOOGLE_CLOUD_VISION_KEY=

# Push notifications (Firebase Cloud Messaging service account, JSON path)
FCM_SERVICE_ACCOUNT_FILE=

# Database for price history / alerts
DATABASE_URL=postgres://findly:password@localhost:5432/findly
